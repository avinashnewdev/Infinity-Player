{
  "id": "./",
  "name": "Infinity Player",
  "short_name": "Infinity Player",
  "description": "Installable Infinity Player for music, video and playlists",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0A0B10",
  "theme_color": "#0A0B10",
  "icons": [
    {
      "src": "./assets/infinity-player-logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "./assets/infinity-player-logo.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./assets/infinity-player-logo.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "prefer_related_applications": false
}